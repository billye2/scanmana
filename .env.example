# Reference only — lists every env var Scanmana reads. Do NOT copy this to
# .env.local and fill it in: secrets live ONLY in Vercel env vars
# (`vercel env add <NAME> production`). Local commands (npm run dev / migrate /
# backfill / backfill:scans / research / scan:now) borrow them per-process via `vercel env run`.

# Massive (formerly Polygon.io) — free Basic tier API key: https://massive.com
MASSIVE_API_KEY=

# Scanmana's own Neon Postgres (Vercel Marketplace, provisioned with --prefix COIL_).
# NB: the bare DATABASE_URL on the Vercel project is the OLD tableside DB — unused here.
COIL_DATABASE_URL=

# Protects /api/cron/scan and /api/research_job — sent as "Authorization: Bearer <secret>" (Vercel adds it to cron calls; the scan route forwards it to the research function)
CRON_SECRET=

# Web push — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Clerk sign-in (provisioned by `vercel integration add clerk`; dev instance keys on vercel.app)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
