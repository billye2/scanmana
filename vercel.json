{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/cron/scan", "schedule": "0 4 * * 2-6" },
    { "path": "/api/cron/scan", "schedule": "30 5 * * 2-6" }
  ],
  "functions": {
    "api/**/*.py": {
      "maxDuration": 300,
      "memory": 2048,
      "excludeFiles": "{tests/**,.lavish/**,node_modules/**,.next/**,public/**,components/**,app/**,lib/**,scripts/**,db/**,*.md}"
    }
  }
}
